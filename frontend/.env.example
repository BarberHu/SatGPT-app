# React App Environment Template
# This file is documentation only.
# Preferred workflow:
# 1. maintain the repository root ".env"
# 2. let the Windows scripts sync public REACT_APP_* values into
#    "frontend/.env.local" automatically
# Do not treat this file as the runtime source of truth.

HOST=0.0.0.0
PORT=3000
GENERATE_SOURCEMAP=false
REACT_APP_MAPBOX_ACCESS_KEY=
REACT_APP_API_URL=
REACT_APP_COPILOTKIT_URL=

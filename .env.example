# ============================================================
# SatGPT Flood Analysis Platform - Environment Template
# Copy this file to ".env" for local use.
# Commit ".env.example", never commit ".env".
# ============================================================

# ============== Required Secrets / Credentials ==============
# Leave secrets blank in the template. Fill them in locally inside ".env".
OPENAI_API_KEY=
TAVILY_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GEE_PROJECT_ID=

# ============== Optional LLM Overrides ==============
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ============== Service Hosts / Ports ==============
# These are safe defaults for local development.
SATGPT_PUBLIC_HOST=localhost

AGENT_HOST=0.0.0.0
AGENT_PORT=8000
AGENT_DEBUG=True

RUNTIME_HOST=0.0.0.0
RUNTIME_PORT=5000

FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000

# ============== Frontend Public Variables ==============
# These values are public by design and will be synced into
# "frontend/.env.local" by the Windows scripts.
# Leave browser-facing URLs blank unless you intentionally want the
# browser to call a fixed host directly. For LAN sharing, same-origin
# requests plus the React dev proxy are the safer default.
REACT_APP_MAPBOX_ACCESS_KEY=
REACT_APP_API_URL=
REACT_APP_COPILOTKIT_URL=
GENERATE_SOURCEMAP=false

# ============== Optional Runtime Override ==============
# If empty, runtime derives the agent URL from SATGPT_PUBLIC_HOST + AGENT_PORT.
AGENT_URL=

# ============== Optional Observability ==============
LANGSMITH_PROJECT=
LANGSMITH_API_KEY=

# ============== Optional Proxy ==============
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1,::1
# no_proxy=localhost,127.0.0.1,::1

# ============== Optional Browser Security ==============
# Comma-separated browser origins allowed to call FastAPI / Runtime.
# Leave blank to use the default local dev allowlist derived from FRONTEND_PORT.
# SATGPT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000


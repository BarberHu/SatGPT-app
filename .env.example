GOOGLE_APPLICATION_CREDENTIALS=.private-key.json
GEE_PROJECT_ID=''

REACT_APP_MAPBOX_ACCESS_TOKEN=''
REACT_APP_MAPBOX_STYLE_URL=''

OPENAI_API_KEY=''
# OPENAI_API_BASE=https://aihubmix.com/v1
LLM_MODEL=gpt-4o-mini

# Tavily API Key
TAVILY_API_KEY=''

# Internal service discovery only; never set this to the public server IP.
SATGPT_SERVICE_HOST=127.0.0.1
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
AGENT_DEBUG=True
AGENT_WORKERS=1
FORWARDED_ALLOW_IPS=127.0.0.1
SATGPT_HEAVY_CONCURRENCY=5
SATGPT_HEAVY_QUEUE_TIMEOUT_SECONDS=30
RUNTIME_HOST=0.0.0.0
RUNTIME_PORT=5000
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
PROXY_TIMEOUT_MS=300000
PROXY_MAX_SOCKETS=256
GENERATE_SOURCEMAP=false

# proxy settings, change it when you use a proxy, for example, shadowsocks, v2ray, etc.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

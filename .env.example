GOOGLE_APPLICATION_CREDENTIALS=.private-key.json
GEE_PROJECT_ID=''
GEE_PROJECT=''

# DeepSeek Harness SDK
DSH_PROVIDER=deepseek-official
DSH_MODEL=deepseek-v4-flash
DSH_REASONING_EFFORT=default
DSH_MAX_TOKENS=32768
DEEPSEEK_API_KEY=''
AIHUBMIX_API_KEY=''
AIHUBMIX_BASE_URL=https://aihubmix.com/v1
# Optional existing local Harness configuration; values fill only unset DSH/model key fields.
DSH_LOCAL_CONFIG_FILE=''
HARNESS_HOST=127.0.0.1
HARNESS_PORT=8001
SATGPT_ALLOW_REMOTE_HARNESS=false

REACT_APP_MAPBOX_ACCESS_TOKEN=''
REACT_APP_MAPBOX_STYLE_URL=mapbox://styles/unuinweh/clsmw8jm201f201ql5wdgcifp

# Basic map/chat service
OPENAI_API_KEY=''
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
AGENT_WORKERS=1
FORWARDED_ALLOW_IPS=127.0.0.1
SATGPT_HEAVY_CONCURRENCY=5
SATGPT_HEAVY_QUEUE_TIMEOUT_SECONDS=30

# Internal service discovery only; never set this to the public server IP.
SATGPT_SERVICE_HOST=127.0.0.1
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000
PROXY_TIMEOUT_MS=300000
PROXY_MAX_SOCKETS=256
GENERATE_SOURCEMAP=false

# proxy settings, change it when you use a proxy, for example, shadowsocks, v2ray, etc.
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

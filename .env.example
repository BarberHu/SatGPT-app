# SatGPT 唯一填写模板：复制为根目录 .env，禁止提交真实配置。
# 优先级：进程环境变量 > 根目录 .env > 程序默认值。
# 值不展开 ${VAR}；含 #、空格、$ 的值请使用单引号。其他项目配置不被读取。

# ---- GEE（Basic / Agent 共用，必填）----
GEE_PROJECT_ID=
# 可选，默认 .private-key.json；相对路径始终基于项目根目录。
GOOGLE_APPLICATION_CREDENTIALS=.private-key.json

# ---- 地图（浏览器公开配置）----
# 必填：Mapbox 浏览器公开 token，建议限制允许的 URL；不要填 secret token。
REACT_APP_MAPBOX_ACCESS_TOKEN=
# 可选：默认复用项目底图；须有对应样式访问权限。
REACT_APP_MAPBOX_STYLE_URL=mapbox://styles/unuinweh/clsmw8jm201f201ql5wdgcifp

# ---- Basic 模型（独立于 Agent）----
# 必填：Basic 问答、位置解析和推荐使用；只保留在后端。
OPENAI_API_KEY=
# 可选：兼容 OpenAI 的服务地址，默认如下。
OPENAI_API_BASE=https://api.openai.com/v1
# 可选，默认 gpt-4o-mini；兼容平台请填写其可用模型 ID。
LLM_MODEL=gpt-4o-mini

# ---- Harness Agent 模型 ----
# deepseek-official（默认）或 aihubmix。仅需填写所选服务商的密钥。
DSH_PROVIDER=deepseek-official
# 官方服务默认如下；AIHubMix 请填写该平台可用模型 ID。
DSH_MODEL=deepseek-v4-flash
# 官方服务必填；使用 AIHubMix 时留空。
DEEPSEEK_API_KEY=
# AIHubMix 必填；使用官方时留空，模型 ID 应为该平台实际可用值。
AIHUBMIX_API_KEY=
AIHUBMIX_BASE_URL=https://aihubmix.com/v1
# 高级可选：default / off / low / high / max；默认 high。
DSH_REASONING_EFFORT=high
DSH_MAX_TOKENS=32768

# ---- 服务配置（均可选，以下为默认值）----
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000
AGENT_HOST=127.0.0.1
AGENT_PORT=8000
HARNESS_HOST=127.0.0.1
HARNESS_PORT=8001
# 内部后端地址；不要填写公网地址。三个端口必须互不相同。
SATGPT_SERVICE_HOST=127.0.0.1
# 仅影响前端监听；本机使用保留 false。
SATGPT_ALLOW_REMOTE_HARNESS=false
AGENT_WORKERS=1
FORWARDED_ALLOW_IPS=127.0.0.1
SATGPT_HEAVY_CONCURRENCY=5
SATGPT_HEAVY_QUEUE_TIMEOUT_SECONDS=30
PROXY_TIMEOUT_MS=300000
PROXY_MAX_SOCKETS=256
GENERATE_SOURCEMAP=false
# 可选网络代理：只在网络需要时填写。不设置则保留系统环境。
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

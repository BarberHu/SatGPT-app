# ============================================================
# SatGPT Flood Analysis Platform - Environment Template
# Copy this file to ".env" for local use.
# Commit ".env.example", never commit ".env".
# ============================================================

# ============== Required Secrets / Credentials ==============
# Leave secrets blank in the template. Fill them in locally inside ".env".
OPENAI_API_KEY=
TAVILY_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=
GEE_PROJECT_ID=

# ============== Optional LLM Overrides ==============
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ============== Service Hosts / Ports ==============
# These are safe defaults for local development.
SATGPT_PUBLIC_HOST=localhost

FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5001

AGENT_HOST=0.0.0.0
AGENT_PORT=8000
AGENT_DEBUG=True

RUNTIME_HOST=0.0.0.0
RUNTIME_PORT=5000

FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000

# ============== Frontend Public Variables ==============
# These values are public by design and will be synced into
# "frontend/.env.local" by the Windows scripts.
REACT_APP_MAPBOX_ACCESS_KEY=
REACT_APP_API_URL=
REACT_APP_AGENT_API_URL=
REACT_APP_COPILOTKIT_URL=
REACT_APP_FLASK_PROXY_TARGET=
REACT_APP_COPILOTKIT_PROXY_TARGET=
GENERATE_SOURCEMAP=false

# ============== Optional Runtime Override ==============
# If empty, runtime derives the agent URL from SATGPT_PUBLIC_HOST + AGENT_PORT.
AGENT_URL=

# ============== Optional Observability ==============
LANGSMITH_PROJECT=
LANGSMITH_API_KEY=

# ============== Optional Proxy ==============
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890

# ============== Legacy Compatibility Notes ==============
# The application still supports these historical names internally,
# but new local ".env" files should prefer the variables above.
# EE_ACCOUNT=your_service_account_email
# EE_PRIVATE_KEY_FILE=./satgpt-xxx.json
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key
# MAPBOX_ACCESS_KEY=your_mapbox_access_key
# CHATGPT_API_KEY=your_openai_api_key
